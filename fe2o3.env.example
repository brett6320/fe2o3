# Copy to fe2o3.env (gitignored) and fill in.
# The password here must match the contents of secrets/db_password.
FE2O3_DATABASE_URL=postgres://fe2o3:CHANGE-ME@db:5432/fe2o3

# Optional: pin the initial encryption key (64 hex chars / 32 bytes).
# Leave unset to let fe2o3 generate one into /data/keys.json on first boot.
# Generate with: openssl rand -hex 32
#FE2O3_SECRET_KEY=

# Optional overrides
#FE2O3_LOG_LEVEL=info
